---
// Shared chrome, ported from genai/src/routes/__root.tsx (RootShell +
// RootComponent). The per-page <head> SEO block arrives via the "head" slot
// — normally as <SeoHead slot="head" ... />.
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import "../styles/global.css";

interface Props {
  /** Set false on the Daily Office reader, which supplies its own chrome. */
  bodyClass?: string;
}
const { bodyClass } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="Anglican Path" />
    <slot name="head" />

    <!-- No third-party stylesheets. The fonts are self-hosted (imported by
         src/styles/global.css) and Leaflet's CSS is loaded by the map island
         itself, so the map's weight never blocks a text page's first paint. -->
  </head>
  <body class={bodyClass}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <SiteHeader />
    <div id="main-content"><slot /></div>
    <SiteFooter />
  </body>
</html>
