---
// Ported from genai/src/components/site/article-card.tsx.
import type { Article } from "../../data/content";
import Icon from "../Icon.astro";

interface Props { article: Article }
const { article } = Astro.props;
const href = `/learn/${article.slug}/`;
---
<article
  class="group border-t border-border pt-5"
  data-article
  data-search={`${article.title} ${article.summary} ${article.topic}`.toLowerCase()}
>
  <p class="text-xs font-bold uppercase text-primary">{article.topic}</p>
  <h3 class="mt-2 font-display text-2xl font-semibold leading-tight"><a href={href} class="decoration-primary/40 underline-offset-4 group-hover:underline">{article.title}</a></h3>
  <p class="mt-3 leading-7 text-muted-foreground">{article.summary}</p>
  <a href={href} class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary">Read article <Icon name="arrow-right" class="size-4" /></a>
</article>
