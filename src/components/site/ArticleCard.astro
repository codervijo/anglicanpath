---
// Ported from genai/src/components/site/article-card.tsx, now driven by a
// `learn` collection entry instead of the retired src/data/content.ts.
import type { CollectionEntry } from "astro:content";
import { learnHref } from "../../lib/content";
import { topicLabel } from "../../lib/taxonomy";
import Icon from "../Icon.astro";

interface Props { article: CollectionEntry<"learn"> }
const { article } = Astro.props;
const d = article.data;
const href = learnHref(article.id);
const label = topicLabel(d.topic);
---
<article
  class="group border-t border-border pt-5"
  data-article
  data-topic={d.topic}
  data-search={`${d.title} ${d.description} ${label} ${d.targetKeyword}`.toLowerCase()}
>
  <p class="text-xs font-bold uppercase tracking-wide text-primary">
    {label}{d.status !== "published" && <span class="ml-2 text-muted-foreground">· {d.status}</span>}
  </p>
  <h3 class="mt-2 font-display text-2xl font-semibold leading-tight">
    <a href={href} class="decoration-primary/40 underline-offset-4 group-hover:underline">{d.title}</a>
  </h3>
  <p class="mt-3 leading-7 text-muted-foreground">{d.description}</p>
  <a href={href} class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary">
    Read article <Icon name="arrow-right" class="size-4" />
  </a>
</article>
