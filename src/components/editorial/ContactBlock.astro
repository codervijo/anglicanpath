---
// Contact details from src/lib/site.ts. The phone line renders only once a
// real number is configured.
import { CONTACT_EMAIL, CONTACT_PHONE } from "../../lib/site";
interface Props { intro?: string }
const { intro } = Astro.props;
---
<div class="contact-block not-prose mt-6 border-y-2 border-primary bg-secondary/30 px-6 py-6">
  {intro && <p class="text-foreground">{intro}</p>}
  <dl class="mt-3 grid gap-2 sm:grid-cols-[6rem_1fr]">
    <dt class="text-sm font-bold uppercase text-muted-foreground">Email</dt>
    <dd><a href={`mailto:${CONTACT_EMAIL}`} class="font-semibold text-primary underline underline-offset-4">{CONTACT_EMAIL}</a></dd>
    {CONTACT_PHONE && (
      <>
        <dt class="text-sm font-bold uppercase text-muted-foreground">Phone</dt>
        <dd><a href={`tel:${CONTACT_PHONE.replace(/[^+\d]/g, "")}`} class="font-semibold text-primary underline underline-offset-4">{CONTACT_PHONE}</a></dd>
      </>
    )}
  </dl>
</div>
