---
// /paths/ — the index of guided reading paths. The homepage links straight to
// individual paths, so this page exists mainly as a crawlable hub and as the
// breadcrumb parent for /paths/<pathId>/.
import BaseLayout from "../../layouts/BaseLayout.astro";
import SeoHead from "../../components/SeoHead.astro";
import PageIntro from "../../components/site/PageIntro.astro";
import Breadcrumbs from "../../components/site/Breadcrumbs.astro";
import Icon from "../../components/Icon.astro";
import { pathHref, visiblePaths } from "../../lib/content";
import { breadcrumbLd, type Crumb } from "../../lib/jsonld";

const paths = await visiblePaths();

const title = "Guided reading paths — Anglican Path";
const description = "Ordered reading paths for Christians coming to Anglicanism from Evangelical, Roman Catholic, Orthodox-curious and Episcopal backgrounds.";

const crumbs: Crumb[] = [
  { name: "Home", path: "/" },
  { name: "Paths", path: "/paths/" },
];
---
<BaseLayout>
  <Fragment slot="head">
    <SeoHead title={title} description={description} path="/paths/" />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd(crumbs))} />
  </Fragment>

  <main>
    <PageIntro
      eyebrow="Where to start"
      title="Guided reading paths"
      description="Each path is an ordered set of readings for one kind of reader, ending at a parish visit."
    />
    <div class="mx-auto max-w-5xl px-5 pt-6 sm:px-8"><Breadcrumbs crumbs={crumbs} /></div>

    <div class="mx-auto max-w-5xl px-5 py-12 sm:px-8">
      {paths.length === 0 && (
        <p class="py-16 text-lg text-muted-foreground">
          No paths are published yet. Drafts are visible when running <code>astro dev</code>.
        </p>
      )}
      <ul class="grid gap-8 md:grid-cols-2">
        {paths.map(p => (
          <li class="border-t-2 border-primary bg-background p-6 shadow-sm">
            <h2 class="font-display text-2xl font-semibold leading-tight">
              <a href={pathHref(p.id)} class="decoration-primary/40 underline-offset-4 hover:underline">{p.data.title}</a>
            </h2>
            <p class="mt-3 leading-7 text-muted-foreground">{p.data.description}</p>
            <p class="mt-4 text-sm text-muted-foreground">
              {p.data.steps.length} readings, then a parish visit
            </p>
            <a href={pathHref(p.id)} class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary">
              Start this path <Icon name="arrow-right" class="size-4" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</BaseLayout>
