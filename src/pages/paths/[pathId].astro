---
// One guided reading path at /paths/<pathId>/.
//
// Ported from genai/src/routes/paths.$pathId.tsx, now driven by the `paths`
// collection. The step list is server rendered (its /learn/<slug>/ links are
// what makes the path useful for crawling); per-step "read" state is restored
// client side from localStorage by the script below.
//
// A step whose article isn't in this build — a draft in production — renders as
// plain text with a note, never as a link to a page that would 404.
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SeoHead from "../../components/SeoHead.astro";
import Breadcrumbs from "../../components/site/Breadcrumbs.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/Icon.astro";
import { learnHref, visibleLearn, visiblePaths } from "../../lib/content";
import { readingTime } from "../../lib/taxonomy";
import { breadcrumbLd, type Crumb } from "../../lib/jsonld";

export async function getStaticPaths() {
  const entries = await visiblePaths();
  return entries.map(entry => ({ params: { pathId: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const articles = await visibleLearn();
const byId = new Map(articles.map(a => [a.id, a]));

const steps = d.steps.map(step => {
  const article = byId.get(step.article);
  return {
    slug: step.article,
    note: step.note,
    title: article?.data.title ?? step.article,
    minutes: article ? readingTime(article.body ?? "") : null,
    available: Boolean(article),
  };
});

const path = `/paths/${entry.id}/`;
const crumbs: Crumb[] = [
  { name: "Home", path: "/" },
  { name: "Paths", path: "/paths/" },
  { name: d.title, path },
];
const isDraft = d.status !== "published";
---
<BaseLayout>
  <Fragment slot="head">
    <SeoHead
      title={`${d.title} — Anglican Path`}
      description={d.description}
      path={path}
      noindex={isDraft}
      modifiedTime={d.updatedDate.toISOString()}
    />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd(crumbs))} />
  </Fragment>

  <main data-path-id={entry.id} data-step-count={steps.length}>
    <header class="border-b border-border bg-secondary/25">
      <div class="mx-auto max-w-4xl px-5 py-14 sm:px-8 sm:py-20">
        <Breadcrumbs crumbs={crumbs} />
        <p class="mt-8 text-xs font-bold uppercase tracking-wide text-primary">A guided reading path</p>
        <h1 class="mt-3 font-display text-5xl font-semibold sm:text-7xl">{d.title}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">{d.description}</p>
        <p class="mt-4 max-w-2xl text-sm text-muted-foreground"><strong>Who this is for:</strong> {d.audience}</p>
        <div class="mt-8 h-1 w-full bg-muted">
          <div class="h-full bg-primary transition-all" style="width:0%" data-progress-bar></div>
        </div>
        <p class="mt-2 text-sm text-muted-foreground">
          <span data-progress-count>0</span> of {steps.length} readings marked complete
        </p>
      </div>
    </header>

    <div class="mx-auto max-w-4xl px-5 pt-12 sm:px-8">
      <div class="article-body"><Content /></div>
    </div>

    <section class="mx-auto max-w-4xl px-5 py-14 sm:px-8">
      <h2 class="font-display text-3xl font-semibold">Your path</h2>
      <ol class="mt-8">
        {steps.map((step, i) => (
          <li class="grid grid-cols-[auto_1fr_auto] items-start gap-4 border-t border-border py-6">
            <button
              type="button"
              data-step-toggle={step.slug}
              data-step-title={step.title}
              aria-pressed="false"
              aria-label={`Mark read: ${step.title}`}
              class="mt-1 grid size-7 shrink-0 place-items-center rounded-full border border-border bg-background"
            >
              <Icon name="check" class="size-4" data-check hidden />
            </button>
            <div>
              <span class="text-xs font-bold text-primary">STEP {i + 1}</span>
              <h3 class="mt-1 font-display text-2xl font-semibold">
                {step.available
                  ? <a href={learnHref(step.slug)}>{step.title}</a>
                  : <span>{step.title}</span>}
              </h3>
              <p class="mt-2 text-sm text-muted-foreground">
                {step.minutes !== null && (
                  <><Icon name="clock" class="mr-1 inline size-4" />{step.minutes} min read · </>
                )}
                {step.note}
                {!step.available && <em> — not yet published.</em>}
              </p>
            </div>
            <span class="font-display text-3xl text-border">{String(i + 1).padStart(2, "0")}</span>
          </li>
        ))}
        <li class="border-y-2 border-primary bg-secondary/30 p-7">
          <p class="text-xs font-bold uppercase tracking-wide text-primary">Final step</p>
          <h3 class="mt-2 font-display text-3xl font-semibold">Visit a parish</h3>
          <p class="mt-3 text-muted-foreground">
            Reading can only take you so far. The path ends where the tradition is
            actually practised — in a congregation, on a Sunday.
          </p>
          <Button href={d.cta.href} class="mt-6">{d.cta.label}</Button>
        </li>
      </ol>
    </section>
  </main>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("main[data-path-id]");
  if (root) {
    const pathId = root.dataset.pathId!;
    const total = Number(root.dataset.stepCount ?? 0);
    const key = `path-${pathId}`;
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-step-toggle]"));

    let done: string[] = [];
    try {
      done = JSON.parse(localStorage.getItem(key) ?? "[]");
    } catch {
      done = [];
    }

    const ON = ["border-primary", "bg-primary", "text-primary-foreground"];
    const OFF = ["border-border", "bg-background"];

    function render() {
      for (const button of buttons) {
        const slug = button.dataset.stepToggle!;
        const isDone = done.includes(slug);
        button.classList.remove(...(isDone ? OFF : ON));
        button.classList.add(...(isDone ? ON : OFF));
        button.setAttribute("aria-pressed", String(isDone));
        button.setAttribute("aria-label", `${isDone ? "Mark unread" : "Mark read"}: ${button.dataset.stepTitle}`);
        button.querySelector<HTMLElement>("[data-check]")!.hidden = !isDone;
      }
      const bar = root!.querySelector<HTMLElement>("[data-progress-bar]")!;
      bar.style.width = `${total ? (done.length / total) * 100 : 0}%`;
      root!.querySelector<HTMLElement>("[data-progress-count]")!.textContent = String(done.length);
    }

    for (const button of buttons) {
      button.addEventListener("click", () => {
        const slug = button.dataset.stepToggle!;
        done = done.includes(slug) ? done.filter(x => x !== slug) : [...done, slug];
        localStorage.setItem(key, JSON.stringify(done));
        render();
      });
    }

    render();
  }
</script>
