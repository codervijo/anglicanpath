---
// Ported from genai/src/routes/office.tsx (the layout's own index view).
import BaseLayout from "../../layouts/BaseLayout.astro";
import SeoHead from "../../components/SeoHead.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/Icon.astro";

const title = "Pray the Daily Office — Anglican Path";
const description = "Choose Morning or Evening Prayer from the 1928 Book of Common Prayer and read it in a focused view.";
const offices = ["morning", "evening"];
---
<BaseLayout>
  <SeoHead slot="head" title={title} description={description} path="/office/" />
  <main>
    <header class="border-b border-border bg-secondary/25">
      <div class="mx-auto max-w-5xl px-5 py-16 text-center sm:px-8 sm:py-24">
        <Icon name="book-open" class="mx-auto size-7 text-primary" />
        <p class="mt-6 text-xs font-bold uppercase text-primary">Pray the Daily Office</p>
        <h1 class="mt-3 font-display text-5xl font-semibold sm:text-7xl">Friday, 18 September 2026</h1>
        <p class="mt-5 text-muted-foreground">[Liturgical season or feast placeholder]</p>
      </div>
    </header>
    <section class="mx-auto max-w-5xl px-5 py-14 sm:px-8">
      <h2 class="text-center font-display text-3xl font-semibold">Choose an office</h2>
      <div class="mt-8 grid gap-px border border-border bg-border md:grid-cols-2">
        {offices.map(o => (
          <div class="bg-background p-8 text-center">
            <h3 class="font-display text-3xl font-semibold capitalize">{o} Prayer</h3>
            <p class="mt-3 text-sm text-muted-foreground">1928 Book of Common Prayer</p>
            <Button href={`/office/1928/${o}/2026-09-18/`} class="mt-7">Begin {o} prayer</Button>
          </div>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
