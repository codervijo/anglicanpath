---
// Ported from genai/src/routes/index.tsx.
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import Button from "../components/ui/Button.astro";
import ArticleCard from "../components/site/ArticleCard.astro";
import Ornament from "../components/site/Ornament.astro";
import { pathHref, visibleLearn, visiblePaths } from "../lib/content";

const articles = await visibleLearn();
const paths = await visiblePaths();

const site = "https://anglicanpath.org";
const title = "Anglican Path — Discover, Find, Pray";
const description = "Discover the Anglican faith, find a traditional Anglican parish, and pray the Daily Office.";
// Canonical MUST match the served URL incl. trailing slash (trailingSlash:
// 'always' in astro.config.mjs). For a sub-page, derive it the same way:
//   const canonical = `${site}/<route>/`;   // e.g. `${site}/about/`
// A no-slash canonical 308-redirects and breaks indexing (CHECK_161).
const canonical = `${site}/`;

const entries = [
  { title: "Learn", body: "Explore clear, carefully reviewed guides to Anglican belief and practice.", to: "/learn/", icon: "book-open-text" as const },
  { title: "Find a Parish", body: "Search our prototype directory of traditional Anglican churches.", to: "/find-a-parish/", icon: "search" as const },
  { title: "Pray Today", body: "Follow Morning or Evening Prayer in a focused reading view.", to: "/office/", icon: "church" as const },
];
---
<BaseLayout>
  {/*
    The SEO baseline below is written out literally rather than via
    <SeoHead>: src/__tests__/seo.test.js regexes the raw text of this file.
    Every other page uses the <SeoHead> component, which emits the same tags.
  */}
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" type="image/x-icon" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Anglican Path" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD structured data: Organization + WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://anglicanpath.org/#organization",
          "name": "Anglican Path",
          "url": "https://anglicanpath.org/",
        },
        {
          "@type": "WebSite",
          "@id": "https://anglicanpath.org/#website",
          "url": "https://anglicanpath.org/",
          "name": "Anglican Path",
          "publisher": { "@id": "https://anglicanpath.org/#organization" },
        },
      ],
    })} />
  </Fragment>

  <main>
    <section class="relative overflow-hidden border-b border-border">
      <div class="mx-auto max-w-7xl px-5 py-20 text-center sm:px-8 sm:py-28">
        <div class="mx-auto text-2xl text-primary" aria-hidden="true">†</div>
        <h1 class="mx-auto mt-7 max-w-5xl font-display text-5xl font-semibold leading-[1.05] sm:text-7xl">Find an Anglican church. Discover the Anglican faith. Pray the Daily Office.</h1>
        <p class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-muted-foreground">A quiet, trustworthy place to begin—or continue—your path in the Anglican tradition.</p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-14 sm:px-8 sm:py-20">
      <div class="grid gap-px overflow-hidden border border-border bg-border md:grid-cols-3">
        {entries.map(({ title: cardTitle, body, to, icon }) => (
          <a href={to} class="group bg-background p-7 transition-colors hover:bg-secondary/35 sm:p-9">
            <Icon name={icon} class="size-6 text-primary" />
            <h2 class="mt-7 font-display text-3xl font-semibold">{cardTitle}</h2>
            <p class="mt-3 leading-7 text-muted-foreground">{body}</p>
            <span class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-primary">Begin here <Icon name="arrow-right" class="size-4" /></span>
          </a>
        ))}
      </div>
    </section>

    <section class="border-y border-border bg-secondary/25">
      <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-24">
        <div class="max-w-2xl">
          <p class="text-xs font-bold uppercase text-primary">Guided reading</p>
          <h2 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">Start your path</h2>
          <p class="mt-4 leading-7 text-muted-foreground">Choose the background that best describes you. Each path is a short sequence of readings.</p>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {paths.map((path, i) => (
            <a href={pathHref(path.id)} class="border-t-2 border-primary bg-background p-5 shadow-sm transition-transform hover:-translate-y-1">
              <span class="text-xs font-bold text-primary">0{i + 1}</span>
              <h3 class="mt-10 font-display text-2xl font-semibold leading-tight">{path.data.title}</h3>
              <Icon name="arrow-right" class="mt-5 size-4 text-primary" />
            </a>
          ))}
        </div>
        {paths.length === 0 && (
          <p class="mt-10 text-muted-foreground">No reading paths are published yet.</p>
        )}
      </div>
    </section>

    <section class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-8 sm:py-24 md:grid-cols-[1fr_1.25fr] md:items-center">
      <div>
        <p class="text-xs font-bold uppercase text-primary">Friday, 18 September 2026</p>
        <h2 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">Today’s Office</h2>
        <p class="mt-4 text-muted-foreground">[Liturgical season or feast placeholder]</p>
      </div>
      <div class="border-y border-border py-8">
        <p class="font-display text-2xl italic leading-9">“[Daily Office invitation placeholder]”</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <Button href="/office/1928/morning/2026-09-18/">Morning Prayer</Button>
          <Button href="/office/1928/evening/2026-09-18/" variant="outline">Evening Prayer</Button>
        </div>
      </div>
    </section>

    <section class="border-y border-border bg-secondary/25">
      <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-24">
        <h2 class="font-display text-4xl font-semibold">Featured reading</h2>
        <div class="mt-10 grid gap-10 md:grid-cols-3">
          {articles.slice(0, 3).map(a => <ArticleCard article={a} />)}
        </div>
        {articles.length === 0 && (
          <p class="mt-10 text-muted-foreground">No articles are published yet.</p>
        )}
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-5 py-16 text-center sm:px-8 sm:py-24">
      <Ornament />
      <h2 class="font-display text-4xl font-semibold">A short weekly letter on the Anglican way.</h2>
      <p class="mx-auto mt-4 max-w-xl text-muted-foreground">[Email newsletter description placeholder]</p>
      <form class="mx-auto mt-8 grid max-w-lg gap-3 sm:grid-cols-[1fr_auto]" data-noop-form>
        <input
          type="email"
          required
          placeholder="you@example.com"
          aria-label="Email address"
          class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 md:text-sm"
        />
        <Button type="submit">Subscribe</Button>
      </form>
      <p class="mt-3 text-xs text-muted-foreground">UI prototype only. No information is submitted.</p>
    </section>
  </main>
</BaseLayout>

<script>
  // Source used onSubmit={e => e.preventDefault()}; the prototype form has no
  // backend, so keep it inert rather than navigating on submit.
  document
    .querySelectorAll("form[data-noop-form]")
    .forEach(form => form.addEventListener("submit", e => e.preventDefault()));
</script>
