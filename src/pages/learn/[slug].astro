---
// One article at /learn/<slug>/.
//
// Draft and review entries are rendered in `astro dev` only — see
// src/lib/content.ts for why that beats building them with a noindex tag.
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SeoHead from "../../components/SeoHead.astro";
import Breadcrumbs from "../../components/site/Breadcrumbs.astro";
import TableOfContents from "../../components/site/TableOfContents.astro";
import SourcesList from "../../components/site/SourcesList.astro";
import DraftNotice from "../../components/site/DraftNotice.astro";
import ComparisonTable from "../../components/site/ComparisonTable.astro";
import Button from "../../components/ui/Button.astro";
import { learnHref, resolveLearn, visibleLearn, SHOW_UNPUBLISHED } from "../../lib/content";
import { topicLabel, readingTime } from "../../lib/taxonomy";
import { articleLd, breadcrumbLd, faqLd, isAnsweredFaq, type Crumb } from "../../lib/jsonld";

export async function getStaticPaths() {
  const entries = await visibleLearn();
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);

const path = learnHref(entry.id);
const related = await resolveLearn(d.related);
const minutes = readingTime(entry.body ?? "");

const crumbs: Crumb[] = [
  { name: "Home", path: "/" },
  { name: "Learn", path: "/learn/" },
  { name: topicLabel(d.topic), path: `/learn/#${d.topic}` },
  { name: d.title, path },
];

const ld = [
  articleLd({
    headline: d.title,
    description: d.description,
    path,
    updatedDate: d.updatedDate,
    reviewer: d.reviewer,
    reviewedDate: d.reviewedDate,
  }),
  breadcrumbLd(crumbs),
  faqLd(d.faq),
].filter(Boolean);

const dateFmt = new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" });
const isDraft = d.status !== "published";

// Sections the layout appends after the MDX body. render() only reports
// headings it found in the markdown, so these are handed to the TOC by hand —
// the ids must match the <section id="..."> values further down.
const extraHeadings = [
  ...(d.faq && d.faq.length > 0 ? [{ slug: "common-questions", text: "Common questions" }] : []),
  { slug: "primary-sources", text: "Primary sources" },
  ...(related.length > 0 ? [{ slug: "related-questions", text: "Related questions" }] : []),
];
---
<BaseLayout>
  <Fragment slot="head">
    <SeoHead
      title={`${d.title} — Anglican Path`}
      description={d.description}
      path={path}
      ogType="article"
      noindex={isDraft}
      modifiedTime={d.updatedDate.toISOString()}
    />
    {ld.map(block => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </Fragment>

  <main>
    <header class="border-b border-border">
      <div class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
        <Breadcrumbs crumbs={crumbs} />
        <p class="mt-8 text-xs font-bold uppercase tracking-wide text-primary">{topicLabel(d.topic)}</p>
        <h1 class="mt-3 max-w-4xl font-display text-4xl font-semibold leading-tight sm:text-6xl">{d.title}</h1>
        <p class="mt-6 max-w-3xl text-xl leading-8 text-muted-foreground">{d.description}</p>
        <p class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
          {d.reviewer && d.reviewedDate && (
            <>
              <span>Reviewed by {d.reviewer.name}, {d.reviewer.title} on {dateFmt.format(d.reviewedDate)}</span>
              <span aria-hidden="true" class="text-border">·</span>
            </>
          )}
          <span>Updated {dateFmt.format(d.updatedDate)}</span>
          <span aria-hidden="true" class="text-border">·</span>
          <span>{minutes} min read</span>
        </p>
      </div>
    </header>

    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-12 sm:px-8 lg:grid-cols-[14rem_minmax(0,46rem)]">
      <aside>
        <TableOfContents headings={headings} extra={extraHeadings} />
      </aside>

      <article class="article-body min-w-0">
        {SHOW_UNPUBLISHED && isDraft && (
          <DraftNotice
            status={d.status}
            proposed={d.proposed}
            proposedLinks={d.proposedLinks}
            targetKeyword={d.targetKeyword}
            secondaryKeywords={d.secondaryKeywords}
          />
        )}

        {/* data-article-body marks the MDX body for the build gate, which
            counts contextual internal links here and nowhere else — links in
            the TOC, the Related block and the CTA don't count. */}
        <div data-article-body>
          <Content components={{ ComparisonTable }} />
        </div>

        {d.faq && d.faq.length > 0 && (
          <section id="common-questions">
            <h2>Common questions</h2>
            <dl class="faq">
              {d.faq.map(f => (
                <>
                  <dt>{f.q}</dt>
                  <dd>
                    {isAnsweredFaq(f.a)
                      ? f.a
                      : <span class="draft-cell">[DRAFT: first-hand material needed — a direct two-to-three sentence answer]</span>}
                  </dd>
                </>
              ))}
            </dl>
          </section>
        )}

        <SourcesList sources={d.sources} />

        {related.length > 0 && (
          <section id="related-questions">
            <h2>Related questions</h2>
            <ul>
              {related.map(r => <li><a href={learnHref(r.id)}>{r.data.title}</a></li>)}
            </ul>
          </section>
        )}

        <aside class="mt-14 border-y-2 border-primary bg-secondary/30 p-7">
          <h2 class="mt-0">Find a parish near you</h2>
          <p>
            Reading is a beginning. The next step is to worship with a congregation —
            search parishes by jurisdiction, prayer book, and service time.
          </p>
          <Button href="/find-a-parish/">Find a parish near you</Button>
        </aside>
      </article>
    </div>
  </main>
</BaseLayout>
