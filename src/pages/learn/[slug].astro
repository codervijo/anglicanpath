---
// Ported from genai/src/routes/learn.$slug.tsx.
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SeoHead from "../../components/SeoHead.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/Icon.astro";
import { articleSections, articles } from "../../data/content";

export const getStaticPaths: GetStaticPaths = () =>
  articles.map(article => ({ params: { slug: article.slug }, props: { article } }));

const { article } = Astro.props;
const title = `${article.title} — Anglican Path`;
const description = article.summary;
const ld = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  description: article.summary,
  author: { "@type": "Organization", name: "Anglican Path" },
};
const related = articles.filter(x => x.slug !== article.slug).slice(0, 3);
const comparisonRows = ["Authority", "Liturgy", "Sacraments", "Church order"];
---
<BaseLayout>
  <Fragment slot="head">
    <SeoHead title={title} description={description} path={`/learn/${article.slug}/`} ogType="article" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </Fragment>

  <main>
    <header class="border-b border-border">
      <div class="mx-auto max-w-5xl px-5 py-14 sm:px-8 sm:py-20">
        <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
          <a href="/">Home</a> / <a href="/learn/">Learn</a> / <span>{article.title}</span>
        </nav>
        <p class="mt-10 text-xs font-bold uppercase text-primary">{article.topic}</p>
        <h1 class="mt-3 max-w-4xl font-display text-4xl font-semibold leading-tight sm:text-6xl">{article.title}</h1>
        <p class="mt-6 max-w-3xl text-xl leading-8 text-muted-foreground">{article.summary}</p>
        <p class="mt-7 text-sm text-muted-foreground">Reviewed by {article.reviewedBy} · {article.reviewedDate} · {article.readingTime} read</p>
      </div>
    </header>

    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-12 sm:px-8 lg:grid-cols-[14rem_minmax(0,46rem)]">
      <aside>
        <details class="border-y border-border py-3 lg:hidden">
          <summary class="flex cursor-pointer items-center justify-between font-semibold">On this page <Icon name="chevron-down" class="size-4" /></summary>
          <nav class="mt-4">
            <ol class="space-y-3 text-sm text-muted-foreground">
              {articleSections.map(s => <li><a href={`#${s.id}`} class="hover:text-primary">{s.title}</a></li>)}
            </ol>
          </nav>
        </details>
        <div class="sticky top-28 hidden lg:block">
          <p class="text-xs font-bold uppercase text-primary">On this page</p>
          <nav class="mt-4">
            <ol class="space-y-3 text-sm text-muted-foreground">
              {articleSections.map(s => <li><a href={`#${s.id}`} class="hover:text-primary">{s.title}</a></li>)}
            </ol>
          </nav>
        </div>
      </aside>

      <article class="article-body min-w-0">
        <section id="overview">
          <h2>At a glance</h2>
          <p class="drop-cap">[Draft to be written]</p>
          <p>[Draft to be written]</p>
        </section>
        <section id="common-ground">
          <h2>Common ground</h2>
          <p>[Draft to be written]</p>
          <blockquote>“[Primary source quotation placeholder]”<cite>— [Source citation placeholder]</cite></blockquote>
        </section>
        <section id="differences">
          <h2>Important differences</h2>
          <p>[Draft to be written]</p>
          <aside class="pullquote">“[Pull quote placeholder]”</aside>
        </section>
        <section id="comparison">
          <h2>Side-by-side comparison</h2>
          <div class="overflow-x-auto">
            <table>
              <thead><tr><th>Question</th><th>Anglican</th><th>Roman Catholic</th></tr></thead>
              <tbody>
                {comparisonRows.map(x => <tr><th>{x}</th><td>[Draft comparison]</td><td>[Draft comparison]</td></tr>)}
              </tbody>
            </table>
          </div>
        </section>
        <section id="sources">
          <h2>Primary sources</h2>
          <ol class="citations">
            <li>[Primary source citation placeholder]</li>
            <li>[Scholarly citation placeholder]</li>
          </ol>
        </section>
        <section>
          <h2>Related questions</h2>
          <ul>
            {related.map(x => <li><a href={`/learn/${x.slug}/`}>{x.title}</a></li>)}
          </ul>
        </section>
        <aside class="mt-14 border-y-2 border-primary bg-secondary/30 p-7">
          <h2 class="mt-0">Find a parish near you</h2>
          <p>Visit a traditional Anglican parish and continue the conversation in person.</p>
          <Button href="/find-a-parish/">Search sample parishes</Button>
        </aside>
      </article>
    </div>
  </main>
</BaseLayout>
